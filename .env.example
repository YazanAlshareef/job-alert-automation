# Copy to .env.local and fill in. .env.local is gitignored. Never commit keys.
GEMINI_API_KEY=
# Unverified default, set your own: model names change and I have not tested this one against the live API.
GEMINI_MODEL=gemini-2.5-flash
# Telegram (easiest): make a bot with @BotFather, message it once, then find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Or email via SMTP (Gmail needs an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
